# =============================================================================
# Pomniter App — Environment Variables Template
# Copy this to .env and fill in your values
# =============================================================================

# ---------- App ----------
APP_NAME=pomniter
APP_ENV=development
APP_DEBUG=true
APP_PORT=3000

# ---------- Database (PostgreSQL) ----------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=pomniter
POSTGRES_USER=pomniter
POSTGRES_PASSWORD=your_secure_password_here

# ---------- Redis ----------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ---------- Kafka ----------
KAFKA_BROKERS=localhost:9092
KAFKA_GROUP_ID=pomniter-consumers

# ---------- Object Storage (MinIO / S3) ----------
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=pomniter-screenshots
S3_REGION=us-east-1

# ---------- Qdrant (Vector Database) ----------
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=screenshots

# ---------- JWT Auth ----------
JWT_SECRET=your_jwt_secret_here_change_in_production
JWT_EXPIRY=7d
JWT_REFRESH_EXPIRY=30d

# ---------- ML Models ----------
OCR_MODEL_PATH=./ml/models/paddleocr
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
CLIP_MODEL_NAME=apple/MobileCLIP-S2-OpenCLIP

# ---------- Monitoring ----------
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
GRAFANA_ADMIN_PASSWORD=admin
