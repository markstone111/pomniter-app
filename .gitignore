# =============================================================================
# Pomniter App — .gitignore
# Covers: Flutter/Dart, Python, Node.js, Docker, IDE, OS, ML models
# =============================================================================

# ---------- Flutter / Dart ----------
**/build/
**/.dart_tool/
**/.flutter-plugins
**/.flutter-plugins-dependencies
**/.packages
**/.pub-cache/
**/.pub/
**/pubspec.lock
!apps/mobile/pubspec.lock
!packages/*/pubspec.lock

# Generated files
**/*.g.dart
**/*.freezed.dart
**/*.mocks.dart
**/generated_plugin_registrant.dart

# Platform-specific
**/ios/Pods/
**/ios/.symlinks/
**/ios/Flutter/Flutter.framework
**/ios/Flutter/Flutter.podspec
**/android/.gradle/
**/android/local.properties
**/android/**/GeneratedPluginRegistrant.java
**/android/**/GeneratedPluginRegistrant.kt

# ---------- Python ----------
__pycache__/
*.py[cod]
*.class
*.egg-info/
dist/
*.egg
.venv/
venv/
env/
*.whl

# ---------- Node.js ----------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ---------- Docker ----------
docker-compose.override.yml

# ---------- Environment ----------
.env
.env.local
.env.*.local
!.env.example

# ---------- IDE ----------
.idea/
.vscode/
*.swp
*.swo
*~
.project
.classpath
.settings/

# ---------- OS ----------
.DS_Store
Thumbs.db
Desktop.ini
*.lnk

# ---------- ML Models ----------
ml/models/*.onnx
ml/models/*.bin
ml/models/*.pt
ml/models/*.pth
ml/models/*.safetensors
!ml/models/README.md

# ---------- Logs & Temp ----------
*.log
tmp/
temp/
.cache/

# ---------- Coverage ----------
coverage/
.coverage
htmlcov/
lcov.info

# ---------- Build artifacts ----------
*.apk
*.aab
*.ipa
*.app
*.iml
